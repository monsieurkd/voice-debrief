# Copy to .env.local and fill in YOUR OWN values.

# Postgres (see README for the one-time role/db setup).
DATABASE_URL=postgresql://voice:voice@localhost:5432/voicedebrief

# ── LLM provider: any OpenAI-compatible endpoint ─────────────────────────
# Works with OpenAI, Z.ai (GLM), Google Gemini (OpenAI-compatible endpoint),
# OpenRouter, or a local Ollama model. Pick ONE block and fill in your key.
LLM_API_KEY=your-api-key

# Example A — OpenAI (default)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_SMALL_MODEL=gpt-4o-mini

# Example B — Z.ai GLM  (uncomment to use)
# LLM_BASE_URL=https://api.z.ai/api/paas/v4
# LLM_MODEL=glm-4.6
# LLM_SMALL_MODEL=glm-4.5-air

# Example C — Google Gemini, OpenAI-compatible endpoint  (uncomment to use)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_SMALL_MODEL=gemini-2.5-flash-lite
