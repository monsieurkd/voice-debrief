# Copy to .env.local and fill in YOUR OWN values.

# Postgres (see README for the one-time role/db setup).
DATABASE_URL=postgresql://voice:voice@localhost:5432/voicedebrief

# ── LLM provider: any OpenAI-compatible endpoint ─────────────────────────
# The app is now a ChatGPT-style conversational product. ONE fast model powers
# the chat (LLM_SMALL_MODEL); the large thinking model has been removed.
# Works with OpenAI, Z.ai (GLM), Google Gemini (OpenAI-compatible endpoint),
# OpenRouter, or a local Ollama model. Pick ONE block and fill in your key.
LLM_API_KEY=your-api-key

# Example A — OpenAI (default)
LLM_BASE_URL=https://api.openai.com/v1
LLM_SMALL_MODEL=gpt-4o-mini

# Example B — Z.ai GLM  (uncomment to use)
# LLM_BASE_URL=https://api.z.ai/api/paas/v4
# LLM_SMALL_MODEL=glm-4.5-air

# Example C — Google Gemini, OpenAI-compatible endpoint  (uncomment to use)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_SMALL_MODEL=gemini-2.5-flash-lite

# ── Speech-to-text (ASR) ────────────────────────────────────────────────────
# Optional. When unset, batch voice transcription uses the SAME provider as the
# LLM block above (live recorder → OpenAI-compatible /transcriptions, model
# "whisper-1"). Set these ONLY to point transcription at a different endpoint,
# e.g. a dedicated Whisper deployment:
# LLM_ASR_BASE_URL=https://your-whisper.example.com/v1
# LLM_ASR_API_KEY=your-asr-key
# LLM_ASR_MODEL=whisper-1

# ── Speech-to-text OUTPUT (TTS, AI voice replies) ───────────────────────────
# Optional. When a model is set, the assistant's replies are spoken aloud.
# Falls back to the LLM block's base URL + key unless LLM_TTS_* override.
# Requires an OpenAI-compatible /audio/speech endpoint.
# LLM_TTS_MODEL=tts-1
# LLM_TTS_BASE_URL=https://api.openai.com/v1
# LLM_TTS_API_KEY=your-api-key

